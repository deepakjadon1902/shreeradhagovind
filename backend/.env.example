# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080,http://localhost:8081,https://shreeradhagovind.vercel.app,https://shriradhagovindstore.com,https://www.shriradhagovindstore.com

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/shri_radha_govind

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=

# ImageKit (Optional)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/shriradhagovindstore

# Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (Transactional Email)
RESEND_API_KEY=
RESEND_FROM=Shri Radha Govind Store <orders@shriradhagovindstore.com>

# Razorpay Payments & Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Courier Tracking (TrackCourier.io)
TRACKCOURIER_API_KEY=
TRACKCOURIER_MONTHLY_BUDGET=80
TRACKING_IN_TRANSIT_REFRESH_HOURS=24
TRACKING_OFD_REFRESH_MINUTES=120
TRACKING_SYNC_INTERVAL_MINUTES=60
# Set to true only if not using Render Cron Jobs for 'npm run sync:couriers'
ENABLE_IN_PROCESS_TRACKING_SCHEDULER=false

# Bootstrap Admin
ADMIN_EMAIL=shriradhagovindstore@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Shri Radha Govind Store
DELHIVERY_API_TOKEN=
DTDC_API_KEY=